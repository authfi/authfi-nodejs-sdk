  "now": 1792497600,
  "tolerance_seconds": 300,
  "events": [
    "user.created",
    "user.updated",
    "user.deleted",
    "user.blocked",
    "user.mfa_enrolled",
    "group.member_added",
    "group.member_removed",
    "organization.created",
    "role.assigned",
    "session.revoked",
    "login.success",
    "login.failed"
  ],
